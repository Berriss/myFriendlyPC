# Rust build artifacts
/target/

# Local SQLite database & WAL/SHM files (generated at runtime from resources/)
/resources/*.db
/resources/*.db-wal
/resources/*.db-shm
/resources/*.db-journal

# Runtime logs & PID file
.hocg.log
.hocg.pid

# Firebase local deploy cache
/.firebase/

# Python bytecode
__pycache__/
*.py[cod]

# Environment, OS & Service Account Key files
.env
.env.*
*firebase-adminsdk*.json
service-account*.json
firebase-service-account.json
*.key.json
.DS_Store
Thumbs.db
